PORT=3000
# Backend de fila/sessões: memory (padrão, bridge local sem dependências)
# ou redis (modo remoto/Render). Sem STORE, usa redis só se REDIS_URL
# estiver explícito no ambiente — senão cai em memory automaticamente.
STORE=
REDIS_URL=
BRIDGE_POLL_TIMEOUT_SEC=25
COMMAND_TIMEOUT_SEC=25

# ---- Segurança ----
# Sessões: token aleatório, guardado como sha256 no Redis com TTL.
SESSION_TTL_HOURS=24
# Compat legada (token == sessionId sem registro). Deixe 0 em produção.
ALLOW_SELF_SESSION=0
# Rate limit: por sessão (rotas /api/commands) e por IP (criar sessão).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_LIMIT_WINDOW_MS=60000
AUTH_LIMIT_MAX=10
MCP_MSG_LIMIT_MAX=300
# CORS: vazio = sem headers CORS (clientes MCP são server-side).
# Ex: CORS_ORIGIN=https://seu-painel.com
CORS_ORIGIN=
# Atrás de proxy reverso (Railway/Fly/Nginx): 1 p/ rate limit ver IP real.
TRUST_PROXY=0
# Auditoria: últimos N comandos por sessão (GET /api/commands/history).
AUDIT_KEEP=200

# ---- Guards de conteúdo ----
# Kill switch global da tool execute_luau.
ALLOW_EXECUTE_LUAU=1
# 1 = execute_luau visível p/ todas as sessões (comportamento antigo).
# 0 = opt-in: cada sessão ativa via POST /api/commands/mode {"advanced":true}.
ADVANCED_DEFAULT=0
# Tamanho máximo do code (bytes) e de source de scripts.
MAX_LUAU_BYTES=20000
MAX_SOURCE_BYTES=200000
# Padrões extras bloqueados no execute_luau (substring, case-insensitive, vírgula).
LUAU_BLOCKLIST_EXTRA=

# ---- Isolamento entre sessoes ----
# 0 = a IA so comanda o Studio da propria sessao (recomendado).
# 1 = permite sessionId de outra sessao (debug multi-Studio, inseguro).
ALLOW_CROSS_SESSION=0
# Transporte SSE em memoria: rode 1 instancia. 1 = suprime o aviso no boot.
SINGLE_INSTANCE_OK=
# No Render, use TRUST_PROXY=1 p/ o rate limit por IP ver o IP real.
